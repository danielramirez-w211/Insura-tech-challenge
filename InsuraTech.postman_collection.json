        {
          "name": "Login Admin → guarda adminToken",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const r = pm.response.json();",
                  "if (r.token) {",
                  "  pm.collectionVariables.set('adminToken', r.token);",
                  "  console.log('✅ adminToken guardado');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/auth/login", "host": ["{{baseUrl}}"], "path": ["auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@insuratech.com\",\n  \"password\": \"Admin123!\"\n}"
            }
          }
        },
