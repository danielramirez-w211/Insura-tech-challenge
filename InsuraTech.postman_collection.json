{
  "info": {
    "name": "InsuraTech API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "description": "Colección completa de endpoints InsuraTech — Pólizas, Planes de Salud y Motor de Tarifas de Viaje."
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "policyId", "value": "", "type": "string" }
  ],
  "item": [
    {
      "name": "Travel Plans",
      "item": [
        {
          "name": "Calculate — Nacional (10 días)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-plans/calculate?tripType=Nacional&durationDays=10",
              "host": ["{{baseUrl}}"],
              "path": ["travel-plans", "calculate"],
              "query": [
                { "key": "tripType", "value": "Nacional" },
                { "key": "durationDays", "value": "10" }
              ]
            }
          }
        },
        {
          "name": "Calculate — Nacional (30 días — techo COP $37.000)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-plans/calculate?tripType=Nacional&durationDays=30",
              "host": ["{{baseUrl}}"],
              "path": ["travel-plans", "calculate"],
              "query": [
                { "key": "tripType", "value": "Nacional" },
                { "key": "durationDays", "value": "30" }
              ]
            }
          }
        },
        {
          "name": "Calculate — Nacional (180 días — mismo precio que 30)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-plans/calculate?tripType=Nacional&durationDays=180",
              "host": ["{{baseUrl}}"],
              "path": ["travel-plans", "calculate"],
              "query": [
                { "key": "tripType", "value": "Nacional" },
                { "key": "durationDays", "value": "180" }
              ]
            }
          }
        },
        {
          "name": "Calculate — Internacional Europa (10 días)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-plans/calculate?tripType=Internacional&durationDays=10&continent=Europe",
              "host": ["{{baseUrl}}"],
              "path": ["travel-plans", "calculate"],
              "query": [
                { "key": "tripType", "value": "Internacional" },
                { "key": "durationDays", "value": "10" },
                { "key": "continent", "value": "Europe" }
              ]
            }
          }
        },
        {
          "name": "Calculate — Internacional América (30 días)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-plans/calculate?tripType=Internacional&durationDays=30&continent=America",
              "host": ["{{baseUrl}}"],
              "path": ["travel-plans", "calculate"],
              "query": [
                { "key": "tripType", "value": "Internacional" },
                { "key": "durationDays", "value": "30" },
                { "key": "continent", "value": "America" }
              ]
            }
          }
        },
        {
          "name": "Calculate — Error 422: duración excedida (181 días)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-plans/calculate?tripType=Nacional&durationDays=181",
              "host": ["{{baseUrl}}"],
              "path": ["travel-plans", "calculate"],
              "query": [
                { "key": "tripType", "value": "Nacional" },
                { "key": "durationDays", "value": "181" }
              ]
            }
          }
        },
        {
          "name": "Calculate — Error 422: duración inválida (0 días)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/travel-plans/calculate?tripType=Nacional&durationDays=0",
              "host": ["{{baseUrl}}"],
              "path": ["travel-plans", "calculate"],
              "query": [
                { "key": "tripType", "value": "Nacional" },
                { "key": "durationDays", "value": "0" }
              ]
            }
          }
        }
      ]
    },
